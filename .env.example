# Leaderboard API base used by the browser build (the server mounts routes under /api).
# Leave empty to run in local-only mode (runs saved on this device, nothing sent anywhere).
# Same origin as the bundled server (npm start) or the Vite dev proxy: /api
# Separate host: https://void.example.com/api
VITE_VOID_API_URL=

# Server (npm start / npm run dev:server)
PORT=8787
# SQLite file for verified runs. Created on first start.
VOID_DB_PATH=data/void.db
# Comma-separated origins allowed to call the API cross-origin (e.g. the Vite dev server).
VOID_CORS_ORIGINS=http://localhost:5173
